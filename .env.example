# HyperSynth — Environment Variables
# Copy this file to .env and fill in the values.

# ─── Rust Build ──────────────────────────────────────
# Unicode-safe target directory (avoids Hebrew path issues with bindgen)
CARGO_TARGET_DIR=C:\hypersynth-target

# ─── ASIO (Optional — only if you want ASIO audio) ───
# CPAL_ASIO_DIR=C:\path\to\asio_sdk
# LIBCLANG_PATH=C:\Program Files\LLVM\bin

# ─── Audio Device (Optional — standalone only) ───────
# HYPERSYNTH_AUDIO_DEVICE=your_device_name
# HYPERSYNTH_MIDI_INPUT=your_midi_device

# ─── Node.js ─────────────────────────────────────────
# NODE_ENV=development
